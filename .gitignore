.env
.env.*
!.env.example
__pycache__/
*.pyc
venv/
.venv/
instance/
*.db
static/uploads/*
!static/uploads/.gitkeep
gunicorn.log
nohup.out

# Model weights and training data — too large for git, stored in GCS instead
# (see gs://cropguard-uploads-506015/model-artifacts/, pulled down at CI build
# time by .github/workflows/deploy.yml)
models/*.keras
models/*.h5
data/

# One-off packaging artifact, not source
cropguard-app.zip

# Terraform: state lives in gs://cropguard-ai-509423-tfstate, never in git
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
infra/terraform.tfvars
infra/generated.tf*
infra/plan*.txt
